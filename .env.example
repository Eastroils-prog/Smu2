# For local development against the local Supabase stack, copy this file twice:
#   .env.local             (used by `npm run dev`)
#   .env.production.local  (used by `npm run build`, so tests never touch the live project)
# and fill in the URL and anon key that `npx supabase status` prints.
# Both values are safe to show in a browser. NEVER put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLIC_KEY=
